{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/PT233/ask_dog_debug/schemas/incident-manifest.schema.json",
  "title": "IncidentManifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "robot_id",
    "platform",
    "platform_knowledge_status",
    "investigation_state",
    "symptom",
    "root_cause",
    "root_entity_id",
    "impact_entity_id",
    "entities",
    "relations",
    "stages",
    "chains",
    "evidence_refs"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "run_id": { "type": "string", "minLength": 1 },
    "robot_id": { "type": "string", "minLength": 1 },
    "platform": { "enum": ["a2w", "m20"] },
    "platform_knowledge_status": { "const": "ready" },
    "investigation_state": { "enum": ["RootCauseProven", "Closed"] },
    "symptom": { "type": "string", "minLength": 1 },
    "root_cause": { "type": "string", "minLength": 1 },
    "root_entity_id": { "type": "string", "minLength": 1 },
    "impact_entity_id": { "type": "string", "minLength": 1 },
    "entities": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "label", "board", "chain_ids"],
        "properties": {
          "id": { "type": "string" },
          "kind": { "enum": ["node", "topic", "service", "action"] },
          "label": { "type": "string" },
          "board": { "type": "string" },
          "chain_ids": { "type": "array", "minItems": 1, "items": { "type": "string" } }
        }
      }
    },
    "relations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "from", "to", "kind", "chain_ids"],
        "properties": {
          "id": { "type": "string" },
          "from": { "type": "string" },
          "to": { "type": "string" },
          "kind": { "type": "string" },
          "chain_ids": { "type": "array", "minItems": 1, "items": { "type": "string" } }
        }
      }
    },
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "board", "input", "output", "checkpoint", "status", "entity_ids", "chain_ids", "evidence_refs"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "board": { "type": "string" },
          "input": { "type": "string" },
          "output": { "type": "string" },
          "checkpoint": { "type": "string" },
          "status": { "type": "string" },
          "entity_ids": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "chain_ids": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "evidence_refs": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "chains": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "stage_ids"],
        "properties": {
          "id": { "type": "string" },
          "label": { "type": "string" },
          "stage_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } }
        }
      }
    },
    "evidence_refs": { "type": "array", "minItems": 2, "items": { "type": "string" } }
  }
}
